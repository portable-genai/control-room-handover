{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.example/schemas/ops_worklist_export/v1",
  "title": "Ops worklist export (v1)",
  "description": "The cross-repo ops-worklist metrics contract F1 publishes and F2 conforms to, consumed by F5 with drift-guard tests. One snapshot row per feed per as_of: feed id, queue depth, aging buckets, SLA-clock state counts, throughput and as_of. F5 holds this CONSUMED copy because the F1 source repo is not present in this wave; the assumption is recorded in docs/ops-metrics-contract.md. When F1 lands, replace this with a pin to F1's published schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feed_id",
    "as_of",
    "queue_depth",
    "aging",
    "sla",
    "throughput",
    "source"
  ],
  "properties": {
    "feed_id": {
      "type": "string",
      "enum": ["recon_breaks", "disputes"]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "queue_depth": {
      "type": "integer",
      "minimum": 0
    },
    "aging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0-1d", "1-3d", "3-7d", "7d+"],
      "properties": {
        "0-1d": { "type": "integer", "minimum": 0 },
        "1-3d": { "type": "integer", "minimum": 0 },
        "3-7d": { "type": "integer", "minimum": 0 },
        "7d+": { "type": "integer", "minimum": 0 }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["within", "due_soon", "breached"],
      "properties": {
        "within": { "type": "integer", "minimum": 0 },
        "due_soon": { "type": "integer", "minimum": 0 },
        "breached": { "type": "integer", "minimum": 0 }
      }
    },
    "throughput": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feed", "partition"],
      "properties": {
        "feed": { "type": "string", "minLength": 1 },
        "partition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
